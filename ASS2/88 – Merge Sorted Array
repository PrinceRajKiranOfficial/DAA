class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {

        // Start from the end so that elements in nums1
        // are not overwritten before being compared.
        int i = m - 1;
        int j = n - 1;
        int k = m + n - 1;

        // Compare elements from both arrays.
        while (i >= 0 && j >= 0) {

            if (nums1[i] > nums2[j])
                nums1[k--] = nums1[i--];
            else
                nums1[k--] = nums2[j--];
        }

        // Copy remaining elements of nums2.
        while (j >= 0)
            nums1[k--] = nums2[j--];
    }
}

// Time Complexity: O(m + n)
// Space Complexity: O(1)
